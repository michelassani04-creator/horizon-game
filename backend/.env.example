# Copiez ce fichier en ".env" puis remplacez les valeurs. Ne publiez JAMAIS le fichier .env.

# Mot de passe de la base PostgreSQL (longue chaîne aléatoire)
DB_PASSWORD=changez-moi

# Jeton pour publier des jeux (24 caractères minimum). Vide = publication désactivée.
# Générer : openssl rand -hex 24
ADMIN_TOKEN=

# true au premier lancement pour insérer 6 jeux fictifs de démonstration
SEED_DEMO=true

# Durée de connexion en jours
SESSION_DAYS=30

# Tant qu'aucun service d'e-mail n'est branché, les codes de vérification sont écrits dans les logs
LOG_CODES=false

# Avec HTTPS (profil "https") : votre nom de domaine, TRUST_PROXY=true et API_BIND=127.0.0.1:8080
DOMAIN=localhost
TRUST_PROXY=false
API_BIND=8080
